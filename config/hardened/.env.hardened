# Suliko IDE hardened stock-BB launch environment (desktop-v0.49.0)
# Values here are non-secret. Do NOT put provider keys or machine tokens in this file.
# For the packaged app use "bb-app env" or startup flags; .env files are not
# automatically read by the packaged launcher.
BB_SERVER_BIND_HOST=127.0.0.1
BB_TELEMETRY=false# D-046: CLAUDE_CONFIG_DIR and CODEX_HOME must be set at launch to distinct,
# owner-created private directories OUTSIDE the project and verified separately.
# Do not place fixed /tmp paths or credentials here; BB cannot disable
# provider project's settingSources by .env alone.
